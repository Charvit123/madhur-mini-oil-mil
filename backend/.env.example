# Copy to .env and fill in for local dev (or export these as real env vars).
# Values below work out of the box with EITHER docker-compose.yml's db service
# OR a database you created yourself in pgAdmin — Docker is optional.

SPRING_PROFILES_ACTIVE=dev

# --- Database ---
# Point this at whatever Postgres you can see in pgAdmin. If you used Docker
# (docker compose up -d db) or created a `madhur` database + role matching
# these exact values, you can leave the lines below commented out — these are
# already the application-dev.yml defaults.
# DB_URL=jdbc:postgresql://localhost:5432/madhur
# DB_USERNAME=madhur
# DB_PASSWORD=madhur_dev_only

# --- Auth: self-issued JWT, no external IdP needed ---
JWT_SECRET=dev-only-secret-key-change-this-before-deploying-anywhere-real

# No admin username/password env vars — admin logins are rows in the
# admin_user table now (see adminuser.domain.AdminUser), so there can be a
# handful of named accounts instead of one shared one. V4's migration seeds
# a first SUPER_ADMIN: username "admin", password "admin123". Log in with
# that, then create real named accounts via POST /api/admin/admins and
# deactivate the seeded one — see backend/README.md.

# --- Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=

# --- Frontend origin, for CORS and the admin cache-revalidation webhook ---
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=change-me-in-dev
