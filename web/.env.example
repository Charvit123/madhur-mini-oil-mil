# Leave both unset to run fully self-contained against the Next.js API routes
# in app/api/catalogue/** (seeded from lib/data.ts) — no backend needed.
#
# To point the storefront at the real Spring Boot service instead, set:
# NEXT_PUBLIC_API_URL=http://localhost:8080
# API_URL=http://localhost:8080

# Shared secret checked by app/revalidate/route.ts. The Spring admin
# (in.madhuroil.config.RevalidationClient) sends this same value in the
# x-revalidate-secret header after every catalogue write.
REVALIDATE_SECRET=change-me-in-dev

# Needed if you open the dev server from something other than localhost —
# a phone or another machine on your network, via your computer's LAN IP
# (e.g. http://192.168.1.13:3000). On Next.js 16+ this is REQUIRED — without
# it the dev server silently blocks every JS file the page tries to load
# from that address (site looks right, nothing on it works). On Next.js
# 15.x it's optional, just silences a console warning. Check which you're
# on with `npx next --version`. Either way this is always safe to set.
# See next.config.mjs's allowedDevOrigins for the full explanation.
DEV_LAN_ORIGIN=192.168.1.13
